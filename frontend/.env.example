# Optional frontend development overrides.
# Leave VITE_API_BASE_URL empty when using Vite's /api proxy.
VITE_API_BASE_URL=

# Change this if the backend is running on another port, e.g. http://localhost:8001
API_PROXY_TARGET=http://localhost:8000

# Optional basemap override
VITE_BASEMAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
